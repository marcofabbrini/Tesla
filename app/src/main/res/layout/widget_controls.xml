<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">
    <ImageView
        android:id="@+id/widget_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_desc" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">
        <ImageView android:id="@+id/btn_serratura" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Apri o chiudi" />
        <ImageView android:id="@+id/btn_fari" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Lampeggia i fari" />
        <ImageView android:id="@+id/btn_clima" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Clima" />
        <ImageView android:id="@+id/btn_sportello" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Sportello di ricarica" />
        <ImageView android:id="@+id/btn_sentinella" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Sentinella" />
    </LinearLayout>
</LinearLayout>
